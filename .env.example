# Whop API Credentials
# Token / API Key: Dashboard > Developer > API Keys
WHOP_API_KEY=your_whop_account_api_key_here

# Account / Company ID: Dashboard > Settings (starts with biz_)
WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxxx

# Product ID: Dashboard > Products (starts with prod_)
WHOP_PRODUCT_ID=prod_xxxxxxxxxxxxx
